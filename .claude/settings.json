{
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL": "1h"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/session-bootstrap.sh\"",
            "description": "Claude cloud sessions: install the toolkit when this home has no hook launcher, then replay SessionStart context",
            "timeout": 240,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/sync-to-user-claude.py\"",
            "description": "Sync agents/skills/hooks/commands to ~/.claude",
            "timeout": 20,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/afk-mode.py\"",
            "description": "Inject autonomous behavioral posture for SSH/tmux/headless sessions",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-context.py\"",
            "description": "Inject the pre-built overnight dream payload and dream notice (ADR-147)",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/operator-context-detector.py\"",
            "description": "Detect operator context (pipeline session, ADR session) and inject context",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-adr-health-check.py\"",
            "description": "Warn if .adr-session.json is orphaned (referenced ADR file missing); silent when no session exists",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-manifest-cache.py\"",
            "description": "Hash-gated /do routing-manifest cache: verify ~/.claude/cache/routing-manifest.txt, regenerate only when INDEX inputs changed (ADR router-improvement-program C5)",
            "timeout": 20,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-task-registry.py\"",
            "description": "Inject incomplete tasks from previous sessions at session start",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-no-agent-summary-check.py\"",
            "description": "Warn inside session when agent_summary preload is not loaded or build anchors are missing; silent when working",
            "timeout": 5,
            "once": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pending-advisory-injector-userprompt.py\"",
            "description": "Inject advisories deferred by Stop hooks (replaces async rewakes)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/review-false-positive-capture.py\"",
            "description": "Capture review false-positive signals when a user disputes a code-review finding",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/prompt-capture.py\"",
            "description": "Capture user prompts as voice samples (git repos only)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/routing-outcome-finalizer.py\"",
            "description": "Finalize routing-decision outcomes on the next user turn (tool-errors + user reaction + re-route); replaces eager SubagentStop boost/decay",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/jev-route-injector-userprompt.py\"",
            "description": "Pre-run jev-route.py on a /d invocation and inject JEV_RESULT before generation starts",
            "timeout": 26
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/suggest-compact.py\"",
            "description": "Advisory: suggests /compact when Edit/Write call count reaches threshold (ADR-103)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-unified-gate.py\"",
            "description": "Unified gate: gitignore-bypass, git-submission, dangerous-command, creation-gate, sensitive-file (ADR-068). Read gets a warn-only sensitive-file check.",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-worktree-edit-guard.py\"",
            "description": "Worktree edit guard: blocks worktree-isolated agents from editing main-repo files outside their worktree (ADR worktree-edit-guard)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-config-protection.py\"",
            "description": "Config protection: blocks edits to linter/formatter config files so the source gets fixed instead of the rule (ADR-115; CONFIG_PROTECTION_BYPASS=1 to allow)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-branch-safety.py\"",
            "description": "Branch safety: blocks git commit on main/master, forces feature branches",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/ci-merge-gate.py\"",
            "description": "Gate: block merge to main/master when CI checks are red",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-review-before-push-gate.py\"",
            "description": "Review-before-push gate: blocks git push and gh pr create/edit/ready to repos that are not non-fork notque repos until /pr-review recorded the commit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-ruff-format-gate.py\"",
            "description": "Ruff format gate: blocks git push when ruff format --check finds violations (Python projects with pyproject.toml only)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-private-name-leak-gate.py\"",
            "description": "Private-name leak gate: blocks git commit/push and gh pr text naming a private component from ~/private-skills (local-only by design; block messages redact the name)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/security-review-hook.py\"",
            "description": "Security review gate: blocks git commit when staged files have HIGH/CRITICAL findings (VEXJOY_SECURITY_REVIEW_SKIP=1 to override)",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-commit-verification-gate.py\"",
            "description": "Commit verification gate: checks for Verified-By: trailer on git commit (starts in observe mode; COMMIT_VERIFY_GATE_MODE=enforce to block)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-synthesis-gate.py\"",
            "description": "Consultation synthesis gate: blocks implementation when ADR consultation is incomplete",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-plan-gate.py\"",
            "description": "Plan gate: blocks implementation code without task_plan.md",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-prompt-injection-scanner.py\"",
            "description": "Advisory scan for prompt injection patterns in agent context files (ADR-070)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pipeline-phase-gate.py\"",
            "description": "Pipeline phase gate: blocks edits that skip required pipeline phases",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-adr-creation-gate.py\"",
            "description": "ADR creation gate: blocks new components without an ADR in adr/",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-file-backup.py\"",
            "description": "Backup files before Edit tool modifies them",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-section-integrity-validator.py\"",
            "description": "Advisory: warn when subagent_type is a skill name or unknown (ARCH-002)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/pretool-dispatch-spec-gate.py\"",
            "description": "Block medium/complex [do-route] dispatches missing Request (verbatim), Acceptance criteria, or Repo state (DISPATCH_SPEC_GATE_MODE=warn to downgrade to advisory)",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttool-skill-frontmatter-check.py\"",
            "description": "Validate skill YAML frontmatter after Write/Edit on SKILL.md files",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttooluse-joy-check-warn.py\"",
            "description": "Warn on joy-check framing violations in .md files at write time",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttooluse-sync-skill-index.py\"",
            "description": "Auto-regenerate installed skill and agent indexes when SKILL.md or agents/*.md is written or edited",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/security-review-hook.py\"",
            "description": "Advisory security scan of just-edited file (matches Anthropic edit-time firing; never blocks; VEXJOY_SECURITY_REVIEW_DISABLE=1 to disable)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/adr-lifecycle-on-merge.py\"",
            "description": "Check ADR implementation status after merge operations",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttool-rename-sweep.py\"",
            "description": "After git mv, scan for stale references to the old filename stem (ADR-129)",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttool-bash-injection-scan.py\"",
            "description": "Advisory scan of files written by Bash commands for prompt-injection patterns (ADR-121); never blocks",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/posttool-session-reads.py\"",
            "description": "Track files read this session (Read tool and read-only Bash commands) for subagent warmstart (ADR-088); single PostToolUse registration, do not add a second Bash entry",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/usage-tracker.py\"",
            "description": "Record Skill and Agent invocation analytics",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/routing-decision-recorder.py\"",
            "description": "Record routing-decision rows per Agent dispatch and per [do-route] marker in a Workflow script (replaces /do Phase 5 action A)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-task-registry.py\"",
            "description": "Record [do-route] dispatches to the durable task registry",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/precompact-archive.py\"",
            "description": "Inject the ADR survival anchor before context compression so a pipeline session can recover",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/subagent-start-warmstart.py\"",
            "description": "Inject parent session context into the subagent at start (SubagentStart lands in the subagent; PreToolUse:Agent lands in the parent, so this hook owns the warmstart block and PreToolUse must not re-register it)",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/routing-outcome-recorder.py\"",
            "description": "Validate routing-decision pending outcomes per subagent stop (decision-row existence + bounded re-queue); next-turn finalizer applies boost/decay",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/session-task-registry.py\"",
            "description": "Update task registry status on subagent completion",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/postcompact-handler.py\"",
            "description": "Re-inject plan context after context compaction",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/routing-outcome-stop-fallback.py\"",
            "description": "Score errored or stale pending routing outcomes; leave clean recent ones for the next-turn finalizer",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/stop-drift-guard.py\"",
            "description": "Advisory: re-wake the session when this session's changes introduce toolkit drift (hook smoke-test, doc-count, or routing-manifest drift) so it can be fixed before CI",
            "timeout": 20,
            "asyncRewake": true,
            "rewakeMessage": "Toolkit drift guard found drift in this session's changes — fix the drift below (or acknowledge it), then continue with the user's original request or continue waiting for their reply. This is supplementary, not a replacement for your previous response:",
            "rewakeSummary": "Toolkit drift guard found drift to review"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.claude/hooks/lib/pyrun.sh\" \"$HOME/.claude/hooks/routing-outcome-stop-fallback.py\"",
            "description": "Resolve every still-pending routing outcome at session end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
